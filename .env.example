# Application
APP_NAME=LeadFlow AI API
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
UPLOAD_DIR=../uploads
EXPORT_DIR=../exports
MAX_UPLOAD_SIZE_MB=10
RUN_MIGRATIONS=true

# Frontend
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8501
BACKEND_API_URL=http://localhost:8000
FRONTEND_BACKEND_API_URL=http://backend:8000

# Local database
# SQLite is the easiest fallback for local backend-only development.
DATABASE_URL=sqlite:///./leadflow.db

# Docker PostgreSQL
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=replace-this-postgres-password
POSTGRES_DB=leadflow
POSTGRES_PORT=5432
DOCKER_DATABASE_URL=postgresql+psycopg://leadflow:replace-this-postgres-password@postgres:5432/leadflow

# Security
# Use a long random value in real environments. Do not reuse this example value.
SECRET_KEY=replace-this-with-a-random-secret-key-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI provider
# Supported values: mock, local, dev, openai, gemini.
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-this-pgadmin-password
PGADMIN_PORT=5050
